{# order-edit.after-order-product-list hook fragment — gift card amounts used on this order #}
<div class="card mb-3">
    <div class="card-header">
        {{ 'Order Gift-Card amount usage for this order'|trans({}, 'theliagiftcard.bo.default-twig') }}
    </div>
    <div class="card-body">
        {% if lines is not empty %}
            <ul class="list-unstyled mb-2">
                {% for line in lines %}
                    <li>
                        {{ 'Montant Carte Cadeau %code : %amount'|trans({
                            '%code': line.code,
                            '%amount': line.spend_amount|number_format(2, '.', ' ') ~ ' ' ~ currency_symbol
                        }, 'theliagiftcard') }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="fw-bold mb-0">
            {{ 'Total payé en carte cadeau'|trans({}, 'theliagiftcard') }} :
            {{ total_spend_amount|number_format(2, '.', ' ') }} {{ currency_symbol }}
        </p>
    </div>
</div>
